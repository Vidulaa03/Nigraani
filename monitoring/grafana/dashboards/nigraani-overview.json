{
  "id": null,
  "uid": "nigraani-overview",
  "title": "NIGRAANI | Operations & Detection",
  "tags": ["nigraani", "security", "operations"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "type": "timeseries", "title": "HTTP requests per second", "description": "Requests served; /metrics scrapes are excluded.", "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(nigraani_http_requests_total[5m]))", "legendFormat": "requests/sec", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
    {"id": 2, "type": "stat", "title": "Total HTTP requests (range)", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 8}, "targets": [{"expr": "sum(increase(nigraani_http_requests_total[$__range]))", "legendFormat": "requests", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 3, "type": "timeseries", "title": "HTTP request latency", "description": "Histogram quantiles calculated across route and method buckets.", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(nigraani_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(nigraani_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"}, {"expr": "histogram_quantile(0.99, sum by (le) (rate(nigraani_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 4, "type": "timeseries", "title": "HTTP responses by status", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum by (status_code) (rate(nigraani_http_requests_total[5m]))", "legendFormat": "{{status_code}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
    {"id": 5, "type": "timeseries", "title": "HTTP 4xx and 5xx error rate", "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(nigraani_http_requests_total{status_code=~\"4..\"}[5m]))", "legendFormat": "4xx/sec", "refId": "A"}, {"expr": "sum(rate(nigraani_http_requests_total{status_code=~\"5..\"}[5m]))", "legendFormat": "5xx/sec", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
    {"id": 6, "type": "table", "title": "Traffic by route and method", "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8}, "targets": [{"expr": "sum by (route, method) (rate(nigraani_http_requests_total[5m]))", "legendFormat": "{{method}} {{route}}", "refId": "A", "format": "table", "instant": true}], "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},
    {"id": 7, "type": "timeseries", "title": "Rule detections by detector and severity", "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8}, "targets": [{"expr": "sum by (detector, severity) (rate(nigraani_detections_total[5m]))", "legendFormat": "{{detector}} / {{severity}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops", "custom": {"drawStyle": "bars"}}, "overrides": []}},
    {"id": 8, "type": "timeseries", "title": "Risk decisions", "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8}, "targets": [{"expr": "sum by (action) (rate(nigraani_risk_decisions_total[5m]))", "legendFormat": "{{action}}", "refId": "A"}], "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}},
    {"id": 9, "type": "barchart", "title": "Risk score distribution", "description": "Existing risk engine scores, 0-100.", "gridPos": {"x": 0, "y": 32, "w": 8, "h": 8}, "targets": [{"expr": "sum by (le) (increase(nigraani_risk_score_bucket[$__range]))", "legendFormat": "≤ {{le}}", "refId": "A", "format": "table", "instant": true}], "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}},
    {"id": 10, "type": "timeseries", "title": "ML anomaly scores", "description": "Model output scores, 0-100; absent when no window was scored.", "gridPos": {"x": 8, "y": 32, "w": 8, "h": 8}, "targets": [{"expr": "histogram_quantile(0.50, sum by (le) (rate(nigraani_ml_anomaly_score_bucket[5m])))", "legendFormat": "p50", "refId": "A"}, {"expr": "histogram_quantile(0.95, sum by (le) (rate(nigraani_ml_anomaly_score_bucket[5m])))", "legendFormat": "p95", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "short", "min": 0, "max": 100}, "overrides": []}},
    {"id": 11, "type": "timeseries", "title": "Analysis duration and failures", "gridPos": {"x": 16, "y": 32, "w": 8, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(nigraani_analysis_duration_seconds_bucket[5m])))", "legendFormat": "p95 duration", "refId": "A"}, {"expr": "rate(nigraani_analysis_failures_total[5m])", "legendFormat": "failures/sec", "refId": "B"}], "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},
    {"id": 12, "type": "stat", "title": "Backend and analyzer scrape health", "gridPos": {"x": 0, "y": 40, "w": 6, "h": 6}, "targets": [{"expr": "up{job=~\"nigraani-backend|nigraani-analyzer\"}", "legendFormat": "{{job}}", "refId": "A"}], "fieldConfig": {"defaults": {"mappings": [{"options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}, "type": "value"}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}}
  ]
}
