# NIGRAANI Environment Configuration Template
# Copy this file to .env and provide your production or test values.
# NEVER commit sensitive API keys or real credentials to source control.

# ==============================================================================
# Gemini Incident Investigation
# ==============================================================================
GEMINI_API_KEY=
# Set this to a model ID available to the Google AI project for this key.
GEMINI_MODEL=

# ==============================================================================
# Twilio Voice Alerting Configuration
# ==============================================================================
# Twilio Account SID (starts with AC...)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Twilio Auth Token
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Outbound caller phone number provisioned in Twilio (E.164 format, e.g. +12025550199)
TWILIO_FROM_NUMBER=+12025550199

# Authorized destination phone number for security alerts (E.164 format, e.g. +12025550188)
# Calls will ONLY be placed to this verified recipient for security safeguards.
TWILIO_TO_NUMBER=+12025550188

# Set true for a Twilio trial account. Trial mode uses Twilio's sample voice
# prompt and omits full-account-only parameters and the custom incident speech.
TWILIO_TRIAL_MODE=false
TWILIO_TRIAL_VOICE_URL=https://webhooks.twilio.com/v1/Voice/Template/voice_text_to_speech

# Base URL for Twilio webhook status callbacks (e.g. https://soc.yourcompany.com or ngrok URL)
# The backend will register `${TWILIO_CALLBACK_BASE_URL}/api/dashboard/calls/callback`
TWILIO_CALLBACK_BASE_URL=

# Toggle voice alerting on or off (defaults to true when credentials exist)
TWILIO_VOICE_ENABLED=true

# Minimum severity threshold (0-100) to trigger an outbound call (default: 80 for CRITICAL)
TWILIO_MIN_SEVERITY=80

# Cooldown window in seconds between outbound calls for the same IP/incident (default: 300)
TWILIO_COOLDOWN_SECONDS=300

# ==============================================================================
# Notification Configuration
# ==============================================================================
# Minimum severity threshold (0-100) to create in-app notifications (default: 50 for MEDIUM+)
NOTIFICATION_MIN_SEVERITY=50
